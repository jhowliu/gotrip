# Environment variables for gotrip.
#
# Copy to `.env` (gitignored) and fill in as needed. M0 needs NONE of these —
# it runs on the scripted model + mock fixtures with zero network. Each variable
# below comes online in a later milestone.
#
# Loading: Node 20.6+ and tsx support `--env-file` natively (no dotenv dependency).
#   tsx --env-file=.env src/interface/cli.ts

# --- M1: real Claude tool-use client (AnthropicModelClient) ---
ANTHROPIC_API_KEY=

# --- LLM provider (OpenAI-compatible client) ---
# Pick a provider explicitly, or leave unset to infer (OpenRouter if its key is set, else OpenAI).
# LLM_PROVIDER=openrouter        # openai | openrouter

# OpenAI
# OPENAI_API_KEY=

# OpenRouter (OpenAI-compatible; base URL preset, override only if needed)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=            # optional ranking header (HTTP-Referer)
# OPENROUTER_APP_NAME=            # optional ranking header (X-Title)

# --- M4: real Google Places / Routes provider ---
# GOOGLE_MAPS_API_KEY=

# ---- MODEL (provider-neutral; OPENAI_MODEL kept as fallback) ----
# For OpenRouter use a namespaced name, e.g. anthropic/claude-sonnet-4-6 or openai/gpt-4o-mini
# LLM_MODEL=gpt-5.4-mini
# LLM_ESCALATION_MODEL=gpt-5.4
