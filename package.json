{
  "name": "gotrip",
  "version": "0.0.0",
  "private": true,
  "description": "A travel-planning ReAct agent — reusable agent-development skill with trip planning as the carrier.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test -w @gotrip/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "serve": "npm run serve -w @gotrip/backend",
    "serve:env": "npm run serve:env -w @gotrip/backend",
    "cli": "npm run cli -w @gotrip/backend",
    "cli:env": "npm run cli:env -w @gotrip/backend",
    "web": "npm run dev -w @gotrip/web",
    "web:build": "npm run build -w @gotrip/web",
    "dev": "npm run serve -w @gotrip/backend & npm run dev -w @gotrip/web"
  }
}
